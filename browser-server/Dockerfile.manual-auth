FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    git xvfb xauth \
    libgtk-3-0 libdbus-glib-1-2 libxt6 libasound2t64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
ENV PATH="/app/.venv/bin:$PATH"
RUN uv sync --frozen --no-install-project --no-default-groups --group manual-auth
RUN uv run --no-project --group manual-auth python -m invisible_playwright fetch
COPY auth.py ./
COPY browser-server/manual_auth.py ./
COPY browser-server/xvfb-entrypoint.sh ./
COPY keys_EN.csv keys_RU.csv ./

ENTRYPOINT ["sh", "xvfb-entrypoint.sh"]
CMD ["uv", "run", "--group", "manual-auth", "python", "manual_auth.py"]
