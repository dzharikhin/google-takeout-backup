ARG PLAYWRIGHT_VERSION=1.60.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION=1.60.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    git xvfb xauth \
    libgtk-3-0 libdbus-glib-1-2 libxt6 libasound2t64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
ENV PATH="/app/.venv/bin:$PATH"
ENV PLAYWRIGHT_VERSION=${PLAYWRIGHT_VERSION}
RUN uv sync --frozen --no-install-project --no-default-groups --group browser
RUN uv run --no-project --group browser python -m invisible_playwright fetch
COPY browser-server/browser-server-entrypoint.sh ./
COPY browser-server/xvfb-entrypoint.sh ./
COPY browser-server/generate_launch_config.py ./

ENTRYPOINT ["sh", "xvfb-entrypoint.sh"]
CMD ["sh", "browser-server-entrypoint.sh"]
